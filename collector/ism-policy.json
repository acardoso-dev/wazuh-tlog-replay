{
  "policy": {
    "description": "Deletes session recordings after the retention period.",
    "default_state": "retido",
    "states": [
      {
        "name": "retido",
        "actions": [],
        "transitions": [
          { "state_name": "apagar", "conditions": { "min_index_age": "90d" } }
        ]
      },
      {
        "name": "apagar",
        "actions": [{ "delete": {} }],
        "transitions": []
      }
    ],
    "ism_template": [{ "index_patterns": ["tlog-*"], "priority": 200 }]
  }
}
