[Unit]
Description=Enable Session Replay recording for local users
# Without this, several shell changes in a row would make systemd stop serving the unit.
StartLimitIntervalSec=0

[Service]
Type=oneshot
# Gives adduser time to finish before changing the same user.
ExecStartPre=/bin/sleep 2
ExecStart=/usr/local/sbin/tlog-record-all sync

[Install]
WantedBy=multi-user.target
