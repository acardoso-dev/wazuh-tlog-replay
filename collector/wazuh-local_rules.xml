<!--
  Add to /var/ossec/etc/rules/local_rules.xml on the manager.
  Change the IDs if they are already in use.

  Validate before restarting: an invalid rule prevents analysisd from starting.
  In the tlog JSON, `id` and `user` are Wazuh static fields. That is why `id` uses <id>,
  and not <field name="id">, which is rejected.

  The agent does not need to read the tlog log. These rules protect hosts where it already does:
  an alert would take the session text to wazuh-alerts-*, where anyone who reads alerts would see
  it even without access to tlog-*. Only raise the level of rule 100501 if you accept that.
-->
<group name="tlog,session_recording,">
  <!-- Level 0: each chunk is analyzed, but does not become an alert. Recordings stay in the tlog-* index. -->
  <rule id="100500" level="0">
    <decoded_as>json</decoded_as>
    <field name="rec">\.+</field>
    <field name="timing">\.+</field>
    <description>tlog session recording chunk</description>
  </rule>

  <!-- id=1 is the first chunk of each recording, that is, the start of the session. -->
  <rule id="100501" level="0">
    <if_sid>100500</if_sid>
    <id>^1$</id>
    <description>Recorded session started on host $(host)</description>
  </rule>
</group>
